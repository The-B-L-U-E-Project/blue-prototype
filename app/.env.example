# Prerequisites: Docker + Supabase CLI. Run `supabase start` first, then `supabase status` for values.
# Copy to .env.local and fill in values from `supabase status` (or `supabase status -o env`).
# Vite exposes only variables prefixed with VITE_ to the client.

# Supabase project URL (local default shown; use your project URL in production)
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Supabase anon / publishable key — safe for the browser
VITE_SUPABASE_ANON_KEY=

# Hono API (Wrangler dev server)
VITE_API_BASE=http://localhost:8787